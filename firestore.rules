rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile synced from Firebase Auth (AuthContext register / reads own doc).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /readNotifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // In-app bell feed (written only by Firebase Admin SDK / backend).
    match /notifications/{notificationId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // Deny everything else explicitly (adjust if you add new collections later).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Copy to .env and adjust. The app loads environment from the process (e.g. uvicorn, Railway, Render).

# --- Production / staging (managed PostgreSQL) ---
# Required when ENVIRONMENT=production or on common PaaS hosts (Railway, Render, etc.).
# Example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Railway sometimes exposes a public URL; the app falls back to this if DATABASE_URL is empty.
# DATABASE_PUBLIC_URL=

# --- Local development (PostgreSQL recommended, same as production) ---
# 1) From repo root: docker compose up -d  (requires Docker Desktop / Engine)
# 2) Ensure backend/.env exists with DATABASE_URL below (copy from this file if needed):
DATABASE_URL=postgresql://fog:fog@127.0.0.1:5433/fog_platform
ENVIRONMENT=development

# JWT signing for legacy username/password API tokens — use a long random string in production
# SECRET_KEY=
#
# SQLite fallback only if DATABASE_URL is unset (not recommended):
# Omit DATABASE_URL entirely → uses backend/fog_platform.db

# --- Media storage (podcast audio/covers) ---
# Default is local disk (served under /storage).
#
# To store new uploads on Cloudflare R2 (recommended for production):
#   1) Create an R2 bucket + S3 API token in Cloudflare dashboard.
#   2) Attach a custom domain (e.g. media.yoursite.com) with public access; enable CORS for your web app origin.
#   3) Set all of the following on this backend (Railway / Render / .env):
#
# STORAGE_MODE=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=your-bucket-name
# R2_PUBLIC_BASE_URL=https://media.yoursite.com
#
# New podcast/cover uploads then go to R2; DB rows store https://... URLs. The site plays them directly;
# /api/podcasts/{id}/stream redirects to that URL for play counts.
#
# Podcasts uploaded before R2 still point at /storage/... until you re-upload those files or migrate objects.

# --- In-app bell (Firestore) + critical alerts (until admin UI ships) ---
# Server writes to Firestore collection "notifications" via Firebase Admin.
# Use ONE of: JSON string of the service account, OR path to the JSON file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
#
# Protects POST /api/internal/notifications (also accepts Authorization: Bearer <same>).
# ALERTS_INTERNAL_SECRET=long-random-string

# SendGrid (HTTPS API; no extra Python package). Optional; logs a warning if unset.
# SENDGRID_API_KEY=
# ALERT_FROM_EMAIL=noreply@yourdomain.com
# ALERT_EMAIL_RECIPIENTS=you@domain.com,backup@domain.com

# Twilio SMS. Optional; logs a warning if unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890
# ALERT_SMS_RECIPIENTS=+263771234567,+263772345678

# Example (important = true sends email/SMS if configured):
# curl -X POST http://localhost:8000/api/internal/notifications ^
#   -H "Content-Type: application/json" ^
#   -H "X-FOG-Internal-Key: %ALERTS_INTERNAL_SECRET%" ^
#   -d "{\"title\":\"Test\",\"message\":\"Hello\",\"type\":\"event\",\"target\":\"/events\",\"important\":true}"

# Admin web UI uses POST /api/admin/notifications with Firebase ID token + Firestore role "admin"
# (same FIREBASE_SERVICE_ACCOUNT_JSON / GOOGLE_APPLICATION_CREDENTIALS as above).

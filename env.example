# Copy to .env in the repo root (never commit .env).
# On Railway (frontend service), set these as service variables before deploy — they are baked in at build time.

# Backend API
# Local dev → localhost:8000
# Production → your Railway backend URL (e.g. https://api.example.com)
REACT_APP_API_URL=http://localhost:8000

# Firebase Web SDK — Firebase Console → Project settings → Your apps → Web
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
